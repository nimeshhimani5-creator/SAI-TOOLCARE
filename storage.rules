rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product catalog images (Public read, Owner upload)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Repair tool photos and diagnostic inspection images
    match /repairs/{repairId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
